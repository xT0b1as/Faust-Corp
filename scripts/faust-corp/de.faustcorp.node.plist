<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd agent: one Faust Corp node.
     Install: adjust the paths below, then
       cp de.faustcorp.node.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/de.faustcorp.node.plist
     Logs: /tmp/faust-corp.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.faustcorp.node</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/CHANGE-ME/Faust-Corp/dist/cli.js</string>
    <string>--port</string>
    <string>3100</string>
    <string>--allowed-host</string>
    <string>CHANGE-ME.tailnet.ts.net</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/CHANGE-ME</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/faust-corp.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/faust-corp.log</string>
</dict>
</plist>
